{
  "evals": [
    {
      "id": "env-preflight",
      "prompt": "On this Windows-on-Arm machine, set up the Cosmos3 environment described by the skill (ARM64 Python, the pinned torch, the framework at the pinned branch, the dependency file, TorchCodec, the DLL search path) and prove it: save the preflight JSON as outputs/preflight.json and the output of the three verification commands of the skill's Variant 1 as outputs/verify.txt.",
      "expected_outcome": "outputs/preflight.json reports status PASS on an ARM64 interpreter with CUDA available, and outputs/verify.txt shows torch and torchcodec versions with True, the pyarrow-free reasoner config import, and the trainer usage.",
      "assertions": [
        "The interpreter used reports platform.machine() == ARM64 and torch.cuda.is_available() is True",
        "cosmos-framework was installed from the branch the skill names, editable and without dependencies, and the dependency file installed with its platform markers applied",
        "The reasoner config imported with pyarrow blocked, as the skill's verification command does",
        "The skill's documented Variant 1 workflow executed without errors on the first attempt",
        "result_summary.md records the torch, torchcodec and framework versions actually installed and the CUDA memory the preflight reported"
      ],
      "checks": [
        {"path": "outputs/preflight.json", "min_bytes": 100},
        {"path": "outputs/verify.txt", "min_bytes": 100},
        {"path": "result_summary.md", "min_bytes": 150}
      ],
      "stages": ["interpreter and torch", "framework and dependencies", "verify"]
    },
    {
      "id": "nano-lora-smoke",
      "prompt": "Using the environment from the skill, convert nvidia/Cosmos3-Nano to the VLM directory, generate the skill's synthetic smoke set with scripts/make_smoke_set.py, and run the 20-step LoRA SFT smoke with scripts/train_lora.ps1 on the skill's recipe assets/video_sft_nano_windows.toml. Copy the run's receipt to outputs/train_receipt.json and the training log lines containing avg_loss to outputs/loss.txt.",
      "expected_outcome": "A 20-step LoRA run completes under the thermal limiter with the LoRA injection line in the log, a falling loss, a synchronous DCP checkpoint at checkpoints/epoch_2, and a receipt with exit code 0.",
      "assertions": [
        "The converted model directory holds 750 tensors in safetensors shards and was used through VLM_SAFETENSORS_PATH",
        "The training log contains the LoRA injection line with 144 modules wrapped",
        "The run used sdpa attention on both policy keys and synchronous checkpointing, as the launcher sets",
        "outputs/loss.txt shows avg_loss decreasing across the 20 steps and outputs/train_receipt.json shows ExitCode 0",
        "The skill's documented Variant 2 and Variant 3 workflows executed without errors on the first attempt",
        "result_summary.md reports seconds per step, peak GPU temperature and pacer pauses from the receipt"
      ],
      "checks": [
        {"path": "outputs/train_receipt.json", "min_bytes": 200},
        {"path": "outputs/loss.txt", "min_bytes": 200},
        {"path": "result_summary.md", "min_bytes": 200}
      ],
      "stages": ["convert", "smoke data", "train", "verify"]
    },
    {
      "id": "export-evaluate",
      "prompt": "Export the epoch_2 checkpoint of the smoke run to a merged safetensors directory with the skill's Variant 4 command, then evaluate it on the smoke validation set with the skill's evaluator template (assets/evaluate_binary.toml). Copy the evaluator's results.json to outputs/results.json and the metrics summary to outputs/metrics.txt.",
      "expected_outcome": "The export has zero residual LoRA keys and the evaluator writes one results.json row per validation record with an accuracy summary.",
      "assertions": [
        "The export's model.safetensors.index.json has 750 tensors and no key containing lora",
        "The evaluator ran from the exported directory with the [vision] settings of the template and wrote one row per validation record",
        "outputs/metrics.txt contains an overall accuracy value computed by the evaluator, not by the agent",
        "The skill's documented Variant 4 and Variant 5 workflows executed without errors on the first attempt"
      ],
      "checks": [
        {"path": "outputs/results.json", "min_bytes": 200},
        {"path": "outputs/metrics.txt", "min_bytes": 40},
        {"path": "result_summary.md", "min_bytes": 150}
      ],
      "stages": ["export", "evaluate", "verify"]
    }
  ],
  "credentials": ["HF_TOKEN"],
  "gpus": 1,
  "docker": false,
  "budget": {"minutes": 180, "tokens": 4000000},
  "setup": {
    "repo": "https://github.com/arif-ahmed-nv/cosmos-framework.git",
    "ref": "69fee1f5705c4026eef59dc995978ec474149e72",
    "dest": "/app/repo",
    "src_mount": "/opt/cosmos-src"
  },
  "lift": {"enabled": false}
}
